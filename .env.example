# ── Required: Anthropic API key (claude-sonnet-4-6) ──────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Required: path to your notes folder ──────────────────────────────────────
ACTIVE_FOLDER=/path/to/your/notes

# ── Optional: RAG / vector DB ────────────────────────────────────────────────
DB_PATH=notes.db
VECTOR_DB_PATH=faiss_index.bin
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Optional: enable/disable search features ──────────────────────────────────
ENABLE_BM25=true
ENABLE_FZF=true
ENABLE_GRAPH_EXPANSION=true
TODOIST_ENABLED=true
TODOIST_API_KEY=